rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles are created and updated only by backend functions
    // (Admin SDK bypasses these rules). Clients may read their own doc.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
