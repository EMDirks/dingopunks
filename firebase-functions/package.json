{
  "name": "dpaam-functions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "serve": "firebase emulators:start --config ../firebase.json --only auth,firestore,functions",
    "deploy": "firebase deploy --only functions",
    "test:rules": "firebase emulators:exec --config ../firebase.json --project demo-dpaam-rules --only firestore \"node --test test/firestore.rules.test.js\"",
    "test:codes": "firebase emulators:exec --config ../firebase.json --project demo-dpaam-codes --only firestore \"node --test test/share-codes.test.js\"",
    "test": "npm run test:rules && npm run test:codes"
  },
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.18.0"
  }
}
